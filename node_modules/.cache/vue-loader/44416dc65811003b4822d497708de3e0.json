{"remainingRequest":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/myeongjunho/Desktop/websites/uilab-github.github.io/src/components/TagSelector.vue?vue&type=style&index=0&id=2f0ab1ce&scoped=true&lang=css&","dependencies":[{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/src/components/TagSelector.vue","mtime":1791269925182},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/css-loader/index.js","mtime":1791269240615},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1791269242071},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/postcss-loader/src/index.js","mtime":1791269241361},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/cache-loader/dist/cjs.js","mtime":1791269240356},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/index.js","mtime":1791269242071}],"contextDependencies":[],"result":["\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n.tags {\n  padding: 0.3em 0;\n  overflow: auto;\n}\n.link-buttons {\n  flex-wrap: wrap;\n  overflow: visible;\n  gap: 0.5rem 0.4rem;\n}\n.link-buttons.link-buttons-large .tag {\n  margin: 0;\n}\n.tag {\n  opacity: 0.5;\n}\n.tag.active {\n  opacity: 1;\n  cursor: default;\n  box-shadow: 0 0 0 2px var(--white-color), 0 0 0 4px var(--text-color);\n}\n.tag:hover {\n  opacity: 1;\n}\n",{"version":3,"sources":["TagSelector.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0DA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"TagSelector.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"tag-selector v-padded\">\n    <h3 class=\"row-title\">Topics</h3>\n    <div class=\"link-buttons link-buttons-large\">\n      <a \n        class=\"tag\" \n        :class=\"{ active: value === null }\"\n        @click=\"() => $emit('input', null)\"\n      >\n        Show All\n      </a>\n      <a\n        class=\"tag\" \n        v-for=\"tagId in sortedTagIds\"\n        :key=\"tagId\" \n        :class=\"{ active: value === tagId }\"\n        :style=\"{ backgroundColor: tags[tagId].color }\"\n        @click=\"() => $emit('input', tagId)\"\n      >\n        {{ tags[tagId].title }}\n      </a>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'tag-selector',\n  props: {\n    tags: Object,\n    research: Array,\n    value: String\n  },\n  computed: {\n    // Most-used tags over the last 3 years come first; ties keep the sheet order.\n    sortedTagIds() {\n      const minYear = new Date().getFullYear() - 2\n      const counts = {}\n      for (const category of this.research || []) {\n        for (const item of category.items) {\n          if (!item.year || item.year < minYear) {\n            continue\n          }\n          for (const tagId of item.tags) {\n            counts[tagId] = (counts[tagId] || 0) + 1\n          }\n        }\n      }\n      return Object.keys(this.tags)\n        .map((tagId, i) => ({ tagId, i, count: counts[tagId] || 0 }))\n        .sort((a, b) => (b.count - a.count) || (a.i - b.i))\n        .map(({ tagId }) => tagId)\n    }\n  }\n}\n</script>\n\n<style scoped>\n.tags {\n  padding: 0.3em 0;\n  overflow: auto;\n}\n.link-buttons {\n  flex-wrap: wrap;\n  overflow: visible;\n  gap: 0.5rem 0.4rem;\n}\n.link-buttons.link-buttons-large .tag {\n  margin: 0;\n}\n.tag {\n  opacity: 0.5;\n}\n.tag.active {\n  opacity: 1;\n  cursor: default;\n  box-shadow: 0 0 0 2px var(--white-color), 0 0 0 4px var(--text-color);\n}\n.tag:hover {\n  opacity: 1;\n}\n</style>\n"]}]}