{"remainingRequest":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/myeongjunho/Desktop/websites/uilab-github.github.io/src/components/LabIntro.vue?vue&type=style&index=0&id=583d2384&scoped=true&lang=css&","dependencies":[{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/src/components/LabIntro.vue","mtime":1791273324836},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/css-loader/index.js","mtime":1791269240615},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1791269242071},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/postcss-loader/src/index.js","mtime":1791269241361},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/cache-loader/dist/cjs.js","mtime":1791269240356},{"path":"/Users/myeongjunho/Desktop/websites/uilab-github.github.io/node_modules/vue-loader/lib/index.js","mtime":1791269242071}],"contextDependencies":[],"result":["\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n.intro {\n  display: flex;\n  align-items: center;\n  gap: 3rem;\n  margin-bottom: 2.5rem;\n}\n.lead {\n  flex: 1;\n  max-width: 54rem;\n  margin: 0;\n  font-size: 1.15rem;\n  line-height: 1.75;\n  color: var(--text-color);\n}\n.intro-brand {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  margin-left: auto;\n}\n/* Same proportions as the navbar logo: the image is as tall as the two text lines */\n.intro-logo {\n  display: block;\n  width: 5.25rem;\n  height: 5.25rem;\n}\n.intro-brand-text {\n  padding: 0 0.7rem;\n  font-size: 1.6rem;\n  font-weight: bold;\n  line-height: 1.2em;\n  color: var(--text-color);\n}\n.themes {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.2rem;\n}\n.theme {\n  display: flex;\n  flex-direction: column;\n  padding: 1.1rem 1.2rem;\n  background-color: var(--white-color);\n  border: 1px solid rgba(0, 0, 0, 0.08);\n  border-top: 4px solid var(--main-color);\n  border-radius: 4px;\n}\n.theme-title {\n  margin: 0 0 0.5rem 0;\n  font-size: 1rem;\n  line-height: 1.3;\n  color: var(--text-color);\n}\n.theme-desc {\n  margin: 0 0 0.8rem 0;\n  font-size: 0.85rem;\n  line-height: 1.55;\n  color: var(--text-color);\n}\n.theme-examples {\n  margin-top: auto;\n  font-size: 0.75rem;\n  font-style: italic;\n  color: var(--grey-color);\n}\n@media screen and (max-width: 64rem) {\n  .themes {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n@media screen and (max-width: 48rem) {\n  .themes {\n    grid-template-columns: 1fr;\n  }\n  .lead {\n    font-size: 1rem;\n  }\n  .intro-brand {\n    display: none;\n  }\n}\n",{"version":3,"sources":["LabIntro.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA6FA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"LabIntro.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"lab-intro v-padded\">\n    <div class=\"intro\">\n      <p class=\"lead\">\n        The <strong>Users &amp; Information Lab (U&I Lab)</strong> is a research group in the\n        School of Computing at KAIST, led by Alice Oh. Our mission is to <strong>make AI work well\n        for everyone, across languages, cultures, and communities</strong>. We build benchmarks,\n        datasets, and evaluation frameworks that reveal how large language models understand\n        people, and develop methods that make them more inclusive, safe, and socially aware.\n      </p>\n      <div class=\"intro-brand\">\n        <img class=\"intro-logo\" src=\"@/assets/logo.png\" alt=\"\" />\n        <div class=\"intro-brand-text\">USERS &amp;<br />INFORMATION</div>\n      </div>\n    </div>\n    <h3 class=\"row-title\">Research Themes</h3>\n    <div class=\"themes\">\n      <div\n        class=\"theme\"\n        v-for=\"theme in themes\"\n        :key=\"theme.title\"\n        :style=\"{ borderTopColor: accentOf(theme) }\"\n      >\n        <h4 class=\"theme-title\">{{ theme.title }}</h4>\n        <p class=\"theme-desc\">{{ theme.description }}</p>\n        <div class=\"theme-examples\">{{ theme.examples.join(' · ') }}</div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\n// Themes are written by hand (they are not in the Google Spreadsheet).\n// `tags` are tag ids from the Tags sheet; the first one picks the card's accent color.\nconst THEMES = [\n  {\n    title: 'Culture-Aware & Multilingual AI',\n    description: 'Do LLMs understand everyday knowledge, values, and norms beyond English? We build benchmarks for diverse languages and cultures, study code-switching, and develop open Korean language resources.',\n    examples: ['BLEnD', 'CLIcK', 'Global MMLU', 'KORMo'],\n    tags: ['cc', 'nlp']\n  },\n  {\n    title: 'Evaluating LLMs',\n    description: 'Rethinking how we measure language models, from composition-aware benchmarks and LLM judges to dynamic, interview-style evaluation.',\n    examples: ['BenchHub', 'LLM-as-an-Interviewer', 'JuICE'],\n    tags: ['nlp', 'ml']\n  },\n  {\n    title: 'Safety, Fairness & Values',\n    description: 'Measuring social bias, harmful content, hate speech, and moral decision-making of LLMs across identities and cultures.',\n    examples: ['KoBBQ', 'FINEST', 'Code-Switching Red-Teaming'],\n    tags: ['eth', 'nlp']\n  },\n  {\n    title: 'Social Intelligence & Computational Social Science',\n    description: 'How do LLMs reason about relationships and social dynamics, and what can language tell us about society, from online trolling to lobbying in legislation?',\n    examples: ['Social reasoning in dialogues', 'Troll behavior analysis', 'Lobbying analysis'],\n    tags: ['css', 'nlp']\n  },\n  {\n    title: 'AI for Education',\n    description: 'LLM tutors and writing support for EFL learners and K-12 classrooms, grounded in datasets of real student and AI interactions.',\n    examples: ['RECIPE4U', 'DREsS', 'TutorLens', 'EduZone'],\n    tags: ['edu', 'nlp']\n  },\n  {\n    title: 'Interpreting LLMs',\n    description: 'Opening up the model: how LLMs reason internally, which training data drives their behavior, and where cultural biases live in their representations.',\n    examples: ['Chain-of-thought mechanisms', 'Data attribution', 'Cultural bias in representations'],\n    tags: ['int', 'nlp']\n  }\n]\n\nexport default {\n  name: 'lab-intro',\n  props: {\n    tags: Object\n  },\n  data() {\n    return {\n      themes: THEMES\n    }\n  },\n  methods: {\n    accentOf(theme) {\n      const tag = this.tags[theme.tags[0]]\n      return tag ? tag.color : 'var(--main-color)'\n    }\n  }\n}\n</script>\n\n<style scoped>\n.intro {\n  display: flex;\n  align-items: center;\n  gap: 3rem;\n  margin-bottom: 2.5rem;\n}\n.lead {\n  flex: 1;\n  max-width: 54rem;\n  margin: 0;\n  font-size: 1.15rem;\n  line-height: 1.75;\n  color: var(--text-color);\n}\n.intro-brand {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  margin-left: auto;\n}\n/* Same proportions as the navbar logo: the image is as tall as the two text lines */\n.intro-logo {\n  display: block;\n  width: 5.25rem;\n  height: 5.25rem;\n}\n.intro-brand-text {\n  padding: 0 0.7rem;\n  font-size: 1.6rem;\n  font-weight: bold;\n  line-height: 1.2em;\n  color: var(--text-color);\n}\n.themes {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.2rem;\n}\n.theme {\n  display: flex;\n  flex-direction: column;\n  padding: 1.1rem 1.2rem;\n  background-color: var(--white-color);\n  border: 1px solid rgba(0, 0, 0, 0.08);\n  border-top: 4px solid var(--main-color);\n  border-radius: 4px;\n}\n.theme-title {\n  margin: 0 0 0.5rem 0;\n  font-size: 1rem;\n  line-height: 1.3;\n  color: var(--text-color);\n}\n.theme-desc {\n  margin: 0 0 0.8rem 0;\n  font-size: 0.85rem;\n  line-height: 1.55;\n  color: var(--text-color);\n}\n.theme-examples {\n  margin-top: auto;\n  font-size: 0.75rem;\n  font-style: italic;\n  color: var(--grey-color);\n}\n@media screen and (max-width: 64rem) {\n  .themes {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n@media screen and (max-width: 48rem) {\n  .themes {\n    grid-template-columns: 1fr;\n  }\n  .lead {\n    font-size: 1rem;\n  }\n  .intro-brand {\n    display: none;\n  }\n}\n</style>\n"]}]}